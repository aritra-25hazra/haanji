{
  "name": "HaanJi",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    "ghcr.io/devcontainers/features/java:1": { "version": "21", "installMaven": true }
  },
  "postCreateCommand": "cd engine && pip install -e '.[dev,web,llm]' && cd ../console && npm install --no-audit --no-fund",
  "postAttachCommand": {
    "engine": "cd engine && HAANJI_CONSOLE_URL=https://${CODESPACE_NAME}-5173.${GITHUB_CODESPACES_PORT_FORWARDING_DOMAIN} python -m haanji.cli serve --host 0.0.0.0 --port 8090",
    "console": "cd console && npm run dev -- --host 0.0.0.0 --port 5173"
  },
  "forwardPorts": [8090, 5173],
  "portsAttributes": {
    "8090": { "label": "engine (demo pages + API)", "onAutoForward": "openBrowser" },
    "5173": { "label": "owner console", "onAutoForward": "notify" }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "dbaeumer.vscode-eslint", "redhat.vscode-yaml"],
      "settings": { "python.defaultInterpreterPath": "/usr/local/bin/python" }
    }
  }
}
