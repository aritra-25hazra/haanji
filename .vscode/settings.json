{
  "python.defaultInterpreterPath": "${workspaceFolder}/engine/.venv/bin/python",
  "python.testing.pytestEnabled": true,
  "python.testing.unittestEnabled": false,
  "python.testing.cwd": "${workspaceFolder}/engine",
  "python.testing.pytestArgs": ["tests"],
  "python.analysis.extraPaths": ["${workspaceFolder}/engine"],
  "yaml.schemas": {},
  "files.exclude": {
    "**/__pycache__": true,
    "**/.pytest_cache": true,
    "**/*.egg-info": true
  },
  "editor.rulers": [100],
  "[python]": { "editor.tabSize": 4 },
  "[typescript]": { "editor.tabSize": 2 },
  "[typescriptreact]": { "editor.tabSize": 2 },
  "[yaml]": {
    "editor.tabSize": 2
  },
  "java.compile.nullAnalysis.mode": "automatic"
}
